#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if [ -f "${DPKG_ROOT:-}/var/lib/dnsp-modern-integration/state.json" ]; then
            echo 'Restore DNS with dnsp-configure-dns restore before removing dnsp-modern.' >&2
            exit 1
        fi
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop dnsp-modern-dns-recovery.timer dnsp-modern.service
        fi
        ;;
esac
